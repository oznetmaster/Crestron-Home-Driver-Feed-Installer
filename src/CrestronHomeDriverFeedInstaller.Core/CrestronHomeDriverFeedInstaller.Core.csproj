<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Authors>Neil Colvin</Authors>
    <Company>Neil Colvin</Company>
    <Copyright>Copyright ©2026 Neil Colvin</Copyright>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CrestronHomeDriverFeedInstaller.Core</AssemblyName>
    <RootNamespace>CrestronHomeDriverFeedInstaller.Core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" Version="7.6.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- NuGet.Protocol's transitive PKCS version predates the October 2026 security fixes. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
